# Copy to .env (gitignored) and fill in. Models are chosen per task in config/rubric.yaml (ai.models).
# gemini-* models need GEMINI_API_KEY; claude-* models need ANTHROPIC_API_KEY (or a Portkey virtual key).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Portkey gateway (optional): when PORTKEY_API_KEY is set, Claude calls and Gemini calls (except research, which needs
# Google Search grounding) route through it. For Gemini it uses GEMINI_API_KEY, or a Portkey virtual key if set.
# After adding keys: python -m aic.llm check  (one tiny call; prints the route and the Langfuse trace id)
PORTKEY_API_KEY=
PORTKEY_VIRTUAL_KEY=
# PORTKEY_BASE_URL=https://api.portkey.ai
# Langfuse tracing (optional): one trace + generation per call when both keys are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
