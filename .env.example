# Copy to .env (gitignored) and fill in. Nothing calls a model until ANTHROPIC_API_KEY (or a Portkey virtual key) is set.
ANTHROPIC_API_KEY=
# Portkey gateway (optional): all model calls route through it when PORTKEY_API_KEY is set.
PORTKEY_API_KEY=
PORTKEY_VIRTUAL_KEY=
# PORTKEY_BASE_URL=https://api.portkey.ai
# Langfuse tracing (optional): one trace + generation per call when both keys are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
