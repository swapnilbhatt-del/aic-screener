# Copy to .env (gitignored) and fill in. Models are chosen per task in config/rubric.yaml (ai.models).
# gemini-* models need GEMINI_API_KEY; claude-* models need ANTHROPIC_API_KEY (or a Portkey virtual key).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Portkey gateway (optional): Claude calls route through it when PORTKEY_API_KEY is set. Gemini calls go direct for now.
PORTKEY_API_KEY=
PORTKEY_VIRTUAL_KEY=
# PORTKEY_BASE_URL=https://api.portkey.ai
# Langfuse tracing (optional): one trace + generation per call when both keys are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
